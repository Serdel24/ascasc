Najlepiej użyć bloku try...catch wraz z obiektem transakcji. Oto szkielet tego, jak powinna wyglądać metoda w Twoim serwisie dla Zadania 3:

C#
public async Task ZapiszIPoplacAsync(TwójDto request, CancellationToken cancellationToken)
{
    // 1. Rozpoczynamy jawną transakcję
    using var transaction = await _context.Database.BeginTransactionAsync(cancellationToken);

    try
    {
        // 2. KROK 1: Tworzymy i dodajemy Enrollment
        var enrollment = new Enrollment
        {
            UserId = request.UserId,
            CourseId = request.CourseId,
            EnrollmentDate = DateTime.Now,
            ProgressPercent = 0
        };
        _context.Enrollments.Add(enrollment);
        
        // Zapisujemy, żeby baza wygenerowała ID dla Enrollment (jeśli go potrzebujesz)
        await _context.SaveChangesAsync(cancellationToken);

        // 3. KROK 2: Tworzymy i dodajemy Payment
        var payment = new Payment
        {
            UserId = request.UserId,
            CourseId = request.CourseId,
            Amount = request.Amount,
            PaymentDate = DateTime.Now,
            PaymentMethod = request.PaymentMethod
            // Zwróć uwagę na strukturę tabeli Payments ze schematu
        };
        _context.Payments.Add(payment);

        // Zapisujemy płatność
        await _context.SaveChangesAsync(cancellationToken);

        // 4. POTWIERDZENIE (COMMIT)
        // Jeśli doszliśmy tutaj i nie było błędu, ostatecznie i trwale zapisujemy zmiany w bazie
        await transaction.CommitAsync(cancellationToken);
    }
    catch (Exception)
    {
        // 5. WYCOFANIE ZMIAN (ROLLBACK)
        // Jeśli cokolwiek "wybuchnie" po drodze (np. wyjątek bazy danych), wycofujemy wszystko.
        await transaction.RollbackAsync(cancellationToken);
        
        // Rzucamy wyjątek dalej, żeby kontroler mógł zwrócić np. 500 Internal Server Error lub 400 Bad Request
        throw; 
    }
}
