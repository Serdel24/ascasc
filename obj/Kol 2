        a.Title,
        a.DueDate,
        a.MaxScore,
        new LessonDto(a.Lesson.Id, a.Lesson.Title),
        new CourseDto(a.Lesson.Course.Id, a.Lesson.Course.Title),
        a.Submissions.Count()
